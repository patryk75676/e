# Skopiuj ten plik jako .env i uzupełnij:  cp .env.example .env && nano .env

# Token bota — Discord Developer Portal > Twoja aplikacja > Bot > Reset Token
DISCORD_TOKEN=wklej_tutaj_token

# Application ID (Client ID) — zakładka General Information
CLIENT_ID=wklej_tutaj_client_id

# ID Twojego serwera Discord (prawy klik na ikonę serwera > Kopiuj ID serwera).
# Wymaga włączonego Trybu dewelopera: Ustawienia > Zaawansowane > Tryb dewelopera.
# Komendy rejestrowane na GUILD_ID pojawiają się natychmiast (globalne nawet do 1h).
GUILD_ID=wklej_tutaj_id_serwera
