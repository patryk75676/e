<Application
    x:Class="GameGrab.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:GameGrab.Views"
    StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <views:BytesConverter       x:Key="BytesConv"   />
            <views:RateConverter        x:Key="RateConv"    />
            <views:StateToColorConverter x:Key="StateColor" />
            <views:BoolToVisConverter   x:Key="BoolToVis"   />
        </ResourceDictionary>
    </Application.Resources>
</Application>
