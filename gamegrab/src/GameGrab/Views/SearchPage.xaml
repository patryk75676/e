<ui:Page
    x:Class="GameGrab.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:GameGrab.Views"
    xmlns:vm="clr-namespace:GameGrab.ViewModels"
    Background="Transparent">
    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Find a release" />
            <TextBlock FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="ten sources, parallel, ranked by seeds" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,10" Padding="14,10,10,10"
                CornerRadius="12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Search24" FontSize="22"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown" />
                <ui:Button Grid.Column="2" Appearance="Primary" Margin="8,0,0,0"
                           Content="Search" Command="{Binding SearchCommand}" />
                <ui:Button Grid.Column="3" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" Content="Paste" Command="{Binding PasteMagnetCommand}" />
                <ui:Button Grid.Column="4" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Symbol=DocumentAdd24}" Content=".torrent" Command="{Binding AddTorrentFileCommand}" />
                <ProgressBar Grid.Column="5" Width="90" Margin="8,0,0,0"
                             IsIndeterminate="{Binding Searching}"
                             Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,6,6" CornerRadius="14" Padding="2">
                            <ui:ToggleSwitch Content="{Binding Name}" IsChecked="{Binding Enabled}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="only with seeds" IsChecked="{Binding OnlyWithSeeds}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="filter" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ui:TextBox PlaceholderText="narrow title" Width="220"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </StackPanel>

        <ui:DataGrid Grid.Row="4"
                     x:Name="ResultsGrid"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding Selected}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserSortColumns="True"
                     SelectionMode="Single"
                     RowHeight="36"
                     FontSize="13"
                     MouseDoubleClick="ResultsGrid_DoubleClick">
            <ui:DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Download" Command="{Binding AddSelectedCommand}" />
                    <MenuItem Header="Copy magnet" Command="{Binding CopyMagnetCommand}" />
                    <MenuItem Header="Open source page" Command="{Binding OpenPageCommand}" />
                </ContextMenu>
            </ui:DataGrid.ContextMenu>
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Source"   Binding="{Binding Source}"    Width="110" />
                <DataGridTextColumn Header="Title"    Binding="{Binding Title}"     Width="*" />
                <DataGridTextColumn Header="Size"     Binding="{Binding Size}"      Width="110" />
                <DataGridTextColumn Header="Seeds"    Binding="{Binding Seeders}"   Width="70" />
                <DataGridTextColumn Header="Peers"    Binding="{Binding Leechers}"  Width="70" />
                <DataGridTextColumn Header="Uploaded" Binding="{Binding Uploaded}"  Width="140" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Button Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                       Content="Download selected"
                       Command="{Binding AddSelectedCommand}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Status}" />
        </StackPanel>
    </Grid>
</ui:Page>
