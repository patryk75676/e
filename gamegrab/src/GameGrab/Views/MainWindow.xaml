<ui:FluentWindow
    x:Class="GameGrab.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:GameGrab.Views"
    Title="GameGrab" Width="1280" Height="820"
    MinWidth="960" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <v:BytesConverter x:Key="BytesConv" />
        <v:RateConverter x:Key="RateConv" />
        <v:StateToColorConverter x:Key="StateColor" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GameGrab" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,12,16,8">
            <ui:TextBox x:Name="SearchBox"
                        PlaceholderText="search for a game, a crack, or paste a magnet / .torrent url"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        Width="640" Margin="0,0,10,0"
                        KeyDown="SearchBox_KeyDown" />
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Search24}"
                       Content="Search" Command="{Binding SearchCommand}" Margin="0,0,8,0" />
            <ui:Button Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" Content="Paste link" Command="{Binding PasteMagnetCommand}" Margin="0,0,8,0" />
            <ui:Button Icon="{ui:SymbolIcon Symbol=DocumentAdd24}" Content="Add .torrent" Command="{Binding AddTorrentFileCommand}" Margin="0,0,8,0" />
            <ui:Button Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Content="Downloads" Command="{Binding OpenFolderCommand}" />
        </StackPanel>

        <ui:DataGrid Grid.Row="2"
                     x:Name="ResultsGrid"
                     Margin="16,0,16,8"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserSortColumns="True"
                     SelectionMode="Single"
                     MouseDoubleClick="ResultsGrid_DoubleClick">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                <DataGridTextColumn Header="Seeds" Binding="{Binding Seeders}" Width="70" />
                <DataGridTextColumn Header="Peers" Binding="{Binding Leechers}" Width="70" />
                <DataGridTextColumn Header="Uploaded" Binding="{Binding Uploaded}" Width="140" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,8">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Content="Download selected" Command="{Binding AddSelectedCommand}" Margin="0,0,8,0" />
            <ui:Button Icon="{ui:SymbolIcon Symbol=Pause24}" Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,8,0" />
            <ui:Button Icon="{ui:SymbolIcon Symbol=Play24}" Content="Resume" Command="{Binding ResumeCommand}" Margin="0,0,8,0" />
            <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Content="Remove" Command="{Binding RemoveCommand}" />
        </StackPanel>

        <ui:DataGrid Grid.Row="4"
                     Margin="16,0,16,8"
                     ItemsSource="{Binding Transfers}"
                     SelectedItem="{Binding SelectedTransfer}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     SelectionMode="Single">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTemplateColumn Header="State" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                    Background="{Binding State, Converter={StaticResource StateColor}}">
                                <TextBlock Text="{Binding State}" Foreground="Black" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Progress" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="16" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0.0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource BytesConv}}" Width="100" />
                <DataGridTextColumn Header="Down" Binding="{Binding DownSpeed, Converter={StaticResource RateConv}}" Width="90" />
                <DataGridTextColumn Header="Up" Binding="{Binding UpSpeed, Converter={StaticResource RateConv}}" Width="90" />
                <DataGridTextColumn Header="Seeds" Binding="{Binding Seeds}" Width="60" />
                <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="60" />
                <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" Width="110" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <StatusBar Grid.Row="5" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
