<ui:FluentWindow
    x:Class="GameGrab.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:GameGrab.Views"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
    Title="GameGrab" Width="1360" Height="880"
    MinWidth="1040" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    StateChanged="Window_StateChanged"
    Closing="Window_Closing">
    <ui:FluentWindow.Resources>
        <views:BytesConverter x:Key="BytesConv" />
        <views:RateConverter  x:Key="RateConv" />
        <views:StateToColorConverter x:Key="StateColor" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GameGrab">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding GlobalRates}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1"
                           x:Name="Nav"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="220"
                           CompactPaneLength="48"
                           IsBackButtonVisible="Collapsed"
                           PaneDisplayMode="LeftFluent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Search"    Icon="{ui:SymbolIcon Symbol=Search24}"       TargetPageType="{x:Type views:SearchPage}" />
                <ui:NavigationViewItem Content="Downloads" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" TargetPageType="{x:Type views:DownloadsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"  Icon="{ui:SymbolIcon Symbol=Settings24}"     TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <StatusBar Grid.Row="2" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveCount, StringFormat=active: {0}}" />
            </StatusBarItem>
        </StatusBar>

        <tray:NotifyIcon Grid.Row="0"
                         x:Name="Tray"
                         TooltipText="GameGrab"
                         Icon="pack://application:,,,/Assets/app.ico"
                         LeftClick="Tray_Show"
                         DoubleClick="Tray_Show">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="Tray_Show" />
                    <Separator />
                    <MenuItem Header="Exit" Click="Tray_Exit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
