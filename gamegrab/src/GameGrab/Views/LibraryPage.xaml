<ui:Page
    x:Class="GameGrab.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:GameGrab.Views"
    Background="Transparent">
    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Library+" />
            <TextBlock FontSize="14" VerticalAlignment="Bottom" Margin="10,0,0,4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="add any Steam app to your library" />
        </StackPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,12,0,4"
                    IsOpen="True"
                    Severity="{Binding LoaderOk, Converter={StaticResource BoolToSeverity}}"
                    Title="Steam loader"
                    Message="{Binding LoaderMessage}" />

        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        PlaceholderText="search Steam app by name, or paste an AppID and press 'Add by AppID'"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="Search_KeyDown" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Search24}" Content="Search" Command="{Binding SearchCommand}" />
            <ui:Button Grid.Column="2" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Add24}" Content="Add by AppID" Command="{Binding AddByAppIdCommand}" />
            <ui:Button Grid.Column="3" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Content="Reapply" Command="{Binding ReapplyAllCommand}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Write method" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SteamPath, StringFormat=Steam path: {0}}" />
            <ui:Button Grid.Column="3" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Content="Browse Steam" Command="{Binding BrowseSteamCommand}" />
            <ui:Button Grid.Column="4" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Play24}" Content="Restart Steam" Command="{Binding RestartSteamCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="312" Height="200" Margin="6" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                MouseLeftButtonUp="Card_Click"
                                Tag="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding HeaderUrl}" DecodePixelWidth="312" />
                                    </Image.Source>
                                </Image>
                                <Grid Grid.Row="1" Margin="10,6,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AppId, StringFormat=AppID: {0}}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}"
                                            Background="#3CB371">
                                        <TextBlock Text="in library" Foreground="Black" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,6">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Your unlocked library" />
            <TextBlock Margin="12,2,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Installed.Count, StringFormat={}{0} apps}" />
        </StackPanel>

        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Installed}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="232" Height="110" Margin="6" CornerRadius="8"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="88" Height="88" Margin="8" VerticalAlignment="Center">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding IconUrl}" DecodePixelWidth="120" />
                                    </Image.Source>
                                </Image>
                                <Grid Grid.Column="1" Margin="4,8,8,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AppId}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:Button Grid.Row="1" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Symbol=Delete24}"
                                               Content="Remove"
                                               Command="{Binding DataContext.RemoveSelectedInstalledCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="7" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding Status}" />
    </Grid>
</ui:Page>
