<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Termux jednym przyciskiem: otwarcie systemowego instalatora z pobranym z F-Droid
         Termuksem i okna „Odinstalowac?” dla wersji z Google Play. Kazdy krok potwierdza
         uzytkownik w oknie Androida; instalacja wymaga tez jego zgody w ustawieniach. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Czat konczy odpowiedz w tle: usluga pierwszoplanowa trzyma proces, a powiadomienie
         mowi, ze odpowiedz jest gotowa albo model prosi o zgode na polecenie. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Od Androida 11 obca paczka jest niewidoczna, dopoki nie zostanie tu wymieniona. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Cyphr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cyphr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Nie ma tu linku cyphr://google — przyjmowal token logowania od dowolnej
                 strony. Logowanie Google idzie tylko natywnym wyborem konta. -->

            <!-- „Udostepnij → CYPHR”: zrzut ekranu, zdjecie, PDF albo tekst trafia do pola
                 wpisywania. Nic nie jest wysylane bez uzytkownika. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Udostepnianie obrazu z rozmowy innej aplikacji: tylko wskazany plik, tylko odczyt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ChatService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
